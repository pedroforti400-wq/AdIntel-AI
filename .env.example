# Modelo de variáveis de ambiente do AdIntel AI.
#
# Copie este arquivo para ".env.local" e preencha os valores quando chegar a fase correspondente.
# NUNCA coloque chaves reais neste arquivo: ele é versionado no Git.
# O ".env.local" fica fora do Git (veja o .gitignore).
#
# Fase 1: nenhuma variável é necessária. O projeto funciona só com dados de demonstração.

# Fase 4 — Supabase (banco de dados e login)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # secreta: usada só no servidor

# Fase 5 — Provedor de IA (usado só no servidor)
# AI_PROVIDER=demo
# AI_API_KEY=
